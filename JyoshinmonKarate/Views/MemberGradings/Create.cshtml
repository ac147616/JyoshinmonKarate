@model JyoshinmonKarate.Models.MemberGrading

@{
    ViewData["Title"] = "Create Member Grading";
}

<section class="app-form-page">
    <div class="app-form-card">

        <div class="app-form-header">
            <h1>Add Member Grading</h1>
            <p>Select a member for an upcoming grading session.</p>
        </div>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="MemberId">Member</label>
                    <select asp-for="MemberId" class="form-control" asp-items="ViewBag.MemberId">
                        <option value="">Select a member</option>
                    </select>
                    <span asp-validation-for="MemberId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="GradingId">Grading</label>
                    <select asp-for="GradingId" class="form-control" asp-items="ViewBag.GradingId">
                        <option value="">Select a grading</option>
                    </select>
                    <span asp-validation-for="GradingId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BeltBeforeId">Current Belt</label>
                    <select asp-for="BeltBeforeId" class="form-control" asp-items="ViewBag.BeltBeforeId">
                        <option value="">Select current belt</option>
                    </select>
                    <span asp-validation-for="BeltBeforeId" class="text-danger"></span>
                </div>

            </div>

            <div class="form-actions">
                <button type="submit" class="app-primary-btn">Add to Grading</button>
                <a asp-action="Index" class="app-cancel-link">Cancel</a>
            </div>
        </form>

    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
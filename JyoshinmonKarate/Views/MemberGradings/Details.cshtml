@model JyoshinmonKarate.Models.MemberGrading

@{
    ViewData["Title"] = "Member Grading Details";

    string memberName = Model.Member.FirstName + " " + Model.Member.LastName;

    string result = Model.Status switch
    {
        JyoshinmonKarate.Models.GradingStatus.Pending => "Pending",
        JyoshinmonKarate.Models.GradingStatus.Passed => "Passed",
        JyoshinmonKarate.Models.GradingStatus.NotPassed => "Not Passed",
        _ => "Unknown"
    };

    string resultClass = Model.Status switch
    {
        JyoshinmonKarate.Models.GradingStatus.Pending => "status-warning",
        JyoshinmonKarate.Models.GradingStatus.Passed => "status-success",
        JyoshinmonKarate.Models.GradingStatus.NotPassed => "status-danger",
        _ => ""
    };

    string beltAfter = Model.BeltAfter != null ? Model.BeltAfter.BeltName : "Not yet assigned";
}

<section class="app-form-page">
    <div class="app-form-card">

        <div class="app-form-header">
            <h1>Member Grading Details</h1>
        </div>

        <div class="details-grid">

            <div class="details-item">
                <span>Member</span>
                <p>@memberName</p>
            </div>

            <div class="details-item">
                <span>Grading Session</span>
                <p>@Model.Grading.SessionName</p>
            </div>

            <div class="details-item">
                <span>Grading Date</span>
                <p>@Model.Grading.GradingDate.ToString("dd MMM yyyy")</p>
            </div>

            <div class="details-item">
                <span>Dojo</span>
                <p>@Model.Grading.Club.ClubName</p>
            </div>

            <div class="details-item">
                <span>Belt Before</span>
                <p>@Model.BeltBefore.BeltName</p>
            </div>

            <div class="details-item">
                <span>Belt After</span>
                <p>@beltAfter</p>
            </div>

            <div class="details-item">
                <span>Status</span>
                <p class="status @resultClass">@result</p>
            </div>

        </div>

        <div class="form-actions">
            <a asp-action="Edit" asp-route-id="@Model.MemberGradingId" class="app-primary-btn">Edit Member Grading</a>
            <a asp-action="Index" class="app-cancel-link">Back to List</a>
        </div>

    </div>
</section>
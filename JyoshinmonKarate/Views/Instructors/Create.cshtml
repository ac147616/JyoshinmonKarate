@model JyoshinmonKarate.Models.Instructor

@{
    ViewData["Title"] = "Create Instructor";
}

<section class="app-form-page">
    <div class="app-form-card">

        <div class="app-form-header">
            <h1>Create Instructor</h1>
        </div>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="UserId">User Account</label>
                    <select asp-for="UserId" class="form-control" asp-items="ViewBag.UserId"></select>
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ClubId">Club</label>
                    <select asp-for="ClubId" class="form-control" asp-items="ViewBag.ClubId"></select>
                    <span asp-validation-for="ClubId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BeltId">Belt</label>
                    <select asp-for="BeltId" class="form-control" asp-items="ViewBag.BeltId"></select>
                    <span asp-validation-for="BeltId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DateJoined">Date Joined</label>
                    <input asp-for="DateJoined" class="form-control" />
                    <span asp-validation-for="DateJoined" class="text-danger"></span>
                </div>

            </div>

            <div class="form-actions">
                <button type="submit" class="app-primary-btn">Create Instructor</button>
                <a asp-action="Index" class="app-cancel-link">Cancel</a>
            </div>
        </form>

    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
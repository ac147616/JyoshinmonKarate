@model JyoshinmonKarate.Models.Instructor

@{
    ViewData["Title"] = "Delete Instructor";

    string instructorName = Model.User.FirstName + " " + Model.User.LastName;
}

<section class="app-form-page">
    <div class="app-form-card">

        <div class="app-form-header">
            <h1>Delete Instructor</h1>
            <p class="warning">Deleting this instructor will permanently remove them from the system.</p>
        </div>

        <div class="details-grid">

            <div class="details-item">
                <span>Instructor Name</span>
                <p>@instructorName</p>
            </div>

            <div class="details-item">
                <span>User Account</span>
                <p>@Model.User.Email</p>
            </div>

            <div class="details-item">
                <span>Club</span>
                <p>@Model.Club.ClubName</p>
            </div>

            <div class="details-item">
                <span>Current Belt</span>
                <p>@Model.Belt.BeltName</p>
            </div>

            <div class="details-item">
                <span>Date Joined</span>
                <p>@Model.DateJoined.ToString("dd MMM yyyy")</p>
            </div>

        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="InstructorId" />

            <div class="form-actions">
                <button type="submit" class="app-danger-btn">Delete Instructor</button>
                <a asp-action="Index" class="app-cancel-link">Cancel</a>
            </div>
        </form>

    </div>
</section>
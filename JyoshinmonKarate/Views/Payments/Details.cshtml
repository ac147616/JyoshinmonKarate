@model JyoshinmonKarate.Models.Payment

@{
    ViewData["Title"] = "Payment Details";

    string memberName = Model.Member.FirstName + " " + Model.Member.LastName;
    string paymentMethod = Model.PaymentMethod.ToString();
    string statusClass = "status-muted";

    if (Model.PaymentMethod == JyoshinmonKarate.Models.PaymentMethods.CreditCard)
    {
        paymentMethod = "Credit Card";
    }
    else if (Model.PaymentMethod == JyoshinmonKarate.Models.PaymentMethods.BankTransfer)
    {
        paymentMethod = "Bank Transfer";
    }
    else if (Model.PaymentMethod == JyoshinmonKarate.Models.PaymentMethods.MobilePayment)
    {
        paymentMethod = "Mobile Payment";
    }

    if (Model.Status == JyoshinmonKarate.Models.PaymentStatus.Completed)
    {
        statusClass = "status-success";
    }
    else if (Model.Status == JyoshinmonKarate.Models.PaymentStatus.Pending)
    {
        statusClass = "status-warning";
    }
    else if (Model.Status == JyoshinmonKarate.Models.PaymentStatus.Failed)
    {
        statusClass = "status-danger";
    }
}

<section class="app-form-page">
    <div class="app-form-card">

        <div class="app-form-header">
            <h1>Payment Info</h1>
        </div>

        <div class="details-grid">

            <div class="details-item">
                <span>Member</span>
                <p>@memberName</p>
            </div>

            <div class="details-item">
                <span>Payment Name</span>
                <p>@Model.PaymentName</p>
            </div>

            <div class="details-item">
                <span>Amount</span>
                <p>$@Model.Amount.ToString("0.00")</p>
            </div>

            <div class="details-item">
                <span>Due Date</span>
                <p>@Model.DateDue.ToString("dd MMM yyyy")</p>
            </div>

            <div class="details-item">
                <span>Payment Method</span>
                <p>@paymentMethod</p>
            </div>

            <div class="details-item">
                <span>Payment Status</span>
                <p class="status @statusClass">@Model.Status</p>
            </div>

        </div>

        <div class="form-actions">
            <a asp-action="Edit" asp-route-id="@Model.PaymentId" class="app-primary-btn">Edit Payment</a>
            <a asp-action="Index" class="app-cancel-link">Back to List</a>
        </div>

    </div>
</section>
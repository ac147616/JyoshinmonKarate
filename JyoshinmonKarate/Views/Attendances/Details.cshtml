@model JyoshinmonKarate.Models.Attendance

@{
    ViewData["Title"] = "Attendance Details";

    string memberName = Model.Member.FirstName + " " + Model.Member.LastName;
    string className = Model.Schedule.Level + " | " + Model.Schedule.DayOfWeek;
    string classTime = Model.Schedule.StartTime.ToString("hh:mm tt") + " to " + Model.Schedule.EndTime.ToString("hh:mm tt");
}

<section class="app-form-page">
    <div class="app-form-card">

        <div class="app-form-header">
            <h1>Attendance Info</h1>
        </div>

        <div class="details-grid">

            <div class="details-item">
                <span>Member</span>
                <p>@memberName</p>
            </div>

            <div class="details-item">
                <span>Attendance Date</span>
                <p>@Model.Date.ToString("dd MMM yyyy")</p>
            </div>

            <div class="details-item">
                <span>Dojo</span>
                <p>@Model.Schedule.Club.ClubName</p>
            </div>

            <div class="details-item">
                <span>Class</span>
                <p>@className</p>
            </div>

            <div class="details-item">
                <span>Class Time</span>
                <p>@classTime</p>
            </div>

        </div>

        <div class="form-actions">
            <a asp-action="Edit" asp-route-id="@Model.AttendanceId" class="app-primary-btn">Edit Attendance</a>
            <a asp-action="Index" class="app-cancel-link">Back to List</a>
        </div>

    </div>
</section>
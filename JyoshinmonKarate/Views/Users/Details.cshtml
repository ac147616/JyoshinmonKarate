@model JyoshinmonKarate.Areas.Identity.Data.User

@{
    ViewData["Title"] = "Account Details";

    string fullName = Model.FirstName + " " + Model.LastName;
    string phoneNumber = string.IsNullOrWhiteSpace(Model.PhoneNumber)
        ? "Not provided"
        : Model.PhoneNumber;

    string userRole = ViewBag.UserRole ?? "No role";
    string emailConfirmedClass = Model.EmailConfirmed
        ? "status-success"
        : "status-danger";
}

<section class="app-form-page">
    <div class="app-form-card">

        <div class="app-form-header">
            <h1>Account Details</h1>
        </div>

        <div class="details-grid">

            <div class="details-item">
                <span>Full Name</span>
                <p>@fullName</p>
            </div>

            <div class="details-item">
                <span>Role</span>
                <p>@userRole</p>
            </div>

            <div class="details-item">
                <span>Email</span>
                <p>@Model.Email</p>
            </div>

            <div class="details-item">
                <span>Phone Number</span>
                <p>@phoneNumber</p>
            </div>

            <div class="details-item">
                <span>Email Confirmed</span>

                <p>
                    <span class="status @emailConfirmedClass">
                        @(Model.EmailConfirmed ? "Yes" : "No")
                    </span>
                </p>
            </div>

        </div>

        <div class="form-actions">
            <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="app-primary-btn">
                Edit Account
            </a>

            <a asp-action="Index" class="app-cancel-link">
                Back to List
            </a>
        </div>

    </div>
</section>
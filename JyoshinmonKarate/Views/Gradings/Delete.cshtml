@model JyoshinmonKarate.Models.Grading

@{
    ViewData["Title"] = "Delete Grading";
}

<section class="app-form-page">
    <div class="app-form-card">

        <div class="app-form-header">
            <h1>Delete Grading</h1>
            <p class="warning">Deleting this grading will permanently remove it from the system.</p>
        </div>

        <div class="details-grid">

            <div class="details-item">
                <span>Dojo</span>
                <p>@Model.Club.ClubName</p>
            </div>

            <div class="details-item">
                <span>Grading Date</span>
                <p>@Model.GradingDate.ToString("dd MMM yyyy")</p>
            </div>

            <div class="details-item">
                <span>Start Time</span>
                <p>@Model.GradingStartTime.ToString("hh:mm tt")</p>
            </div>

            <div class="details-item">
                <span>End Time</span>
                <p>@Model.GradingEndTime.ToString("hh:mm tt")</p>
            </div>

        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="GradingId" />

            <div class="form-actions">
                <button type="submit" class="app-danger-btn">Delete Grading</button>
                <a asp-action="Index" class="app-cancel-link">Cancel</a>
            </div>
        </form>

    </div>
</section>
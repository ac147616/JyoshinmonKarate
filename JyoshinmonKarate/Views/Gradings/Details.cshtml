@model JyoshinmonKarate.Models.Grading

@{
    ViewData["Title"] = "Grading Details";
}

<section class="app-form-page">
    <div class="app-form-card">

        <div class="app-form-header">
            <h1>Grading Info</h1>
        </div>

        <div class="details-grid">

            <div class="details-item">
                <span>Dojo</span>
                <p>@Model.Club.ClubName</p>
            </div>

            <div class="details-item">
                <span>Grading Date</span>
                <p>@Model.GradingDate.ToString("dd MMM yyyy")</p>
            </div>

            <div class="details-item">
                <span>Start Time</span>
                <p>@Model.GradingStartTime.ToString("hh:mm tt")</p>
            </div>

            <div class="details-item">
                <span>End Time</span>
                <p>@Model.GradingEndTime.ToString("hh:mm tt")</p>
            </div>

        </div>

        <div class="form-actions">
            <a asp-action="Edit"
                   asp-route-id="@Model.GradingId"
                   class="app-primary-btn">
                Edit Grading
            </a>

            <a asp-action="Index"
                   class="app-cancel-link">
                Back to List
            </a>
        </div>

    </div>
</section>
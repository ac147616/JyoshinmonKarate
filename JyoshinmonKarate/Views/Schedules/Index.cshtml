@model IEnumerable<JyoshinmonKarate.Models.Schedule>

@{
    ViewData["Title"] = "Class Schedules";
    bool isAdmin = User.IsInRole("Admin");
}

<section class="app-index-page schedule-index-page">

    <div class="app-header-row schedule-header-row">
        <div class="app-page-header">
            <h1>Class Schedules</h1>
        </div>

        @if (isAdmin)
        {
            <a asp-action="Create" class="app-add-btn">
                <i class="bi bi-plus-lg"></i>
                Add Class Schedule
            </a>
        }
    </div>

    @foreach (var dojoGroup in Model.GroupBy(s => s.Club.ClubName).OrderBy(g => g.Key))
    {
        <div class="dojo-schedule-section">

            <div class="dojo-schedule-header">
                <h2>@dojoGroup.Key</h2>
            </div>

            <div class="app-table-wrap">
                <table class="app-table schedule-table">
                    <thead>
                        <tr>
                            <th>Instructor</th>
                            <th>Level</th>
                            <th>Day</th>
                            <th>Start Time</th>
                            <th>End Time</th>

                            @if (isAdmin)
                            {
                                <th>Actions</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in dojoGroup)
                        {
                            string instructorName = item.Instructor.User.FirstName + " " + item.Instructor.User.LastName;

                            <tr>
                                <td class="app-primary-cell">@instructorName</td>
                                <td>@item.Level</td>
                                <td>@item.DayOfWeek</td>
                                <td>@item.StartTime.ToString("hh:mm tt")</td>
                                <td>@item.EndTime.ToString("hh:mm tt")</td>

                                @if (isAdmin)
                                {
                                    <td>
                                        <div class="app-row-actions">
                                            <a asp-action="Details" asp-route-id="@item.ScheduleId" class="app-details-link">Details</a>
                                            <a asp-action="Edit" asp-route-id="@item.ScheduleId" class="app-edit-link">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@item.ScheduleId" class="app-delete-link">Delete</a>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    }

    @if (!Model.Any())
    {
        <div class="app-empty-message">No class schedules were found.</div>
    }

</section>
@model JyoshinmonKarate.Models.Schedule

@{
    ViewData["Title"] = "Delete Class Schedule";

    string instructorName = Model.Instructor.User.FirstName + " " + Model.Instructor.User.LastName;
}

<section class="app-form-page">
    <div class="app-form-card">

        <div class="app-form-header">
            <h1>Delete Class Schedule</h1>
            <p class="warning">Deleting this class schedule will permanently remove it from the system.</p>
        </div>

        <div class="details-grid">

            <div class="details-item">
                <span>Dojo</span>
                <p>@Model.Club.ClubName</p>
            </div>

            <div class="details-item">
                <span>Instructor</span>
                <p>@instructorName</p>
            </div>

            <div class="details-item">
                <span>Level</span>
                <p>@Model.Level</p>
            </div>

            <div class="details-item">
                <span>Day of Week</span>
                <p>@Model.DayOfWeek</p>
            </div>

            <div class="details-item">
                <span>Start Time</span>
                <p>@Model.StartTime.ToString("hh:mm tt")</p>
            </div>

            <div class="details-item">
                <span>End Time</span>
                <p>@Model.EndTime.ToString("hh:mm tt")</p>
            </div>

        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="ScheduleId" />

            <div class="form-actions">
                <button type="submit" class="app-danger-btn">Delete Schedule</button>
                <a asp-action="Index" class="app-cancel-link">Cancel</a>
            </div>
        </form>

    </div>
</section>
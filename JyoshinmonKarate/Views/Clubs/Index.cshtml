@model IEnumerable<JyoshinmonKarate.Models.Club>

@{
    ViewData["Title"] = "Dojos";
}

<section class="app-index-page compact">

    <div class="app-header-row">
        <div class="app-page-header">
            <h1>Dojos</h1>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="app-add-btn">
                <i class="bi bi-plus-lg"></i>
                Add Dojo
            </a>
        }
    </div>

    <div class="app-table-wrap">
        <table class="app-table dojo-table">
            <thead>
                <tr>
                    <th>Dojo Name</th>
                    <th>Address</th>
                    <th>Phone</th>
                    <th>Email</th>

                    @if (User.IsInRole("Admin"))
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="app-primary-cell">@item.ClubName</td>
                        <td>@item.Address</td>
                        <td>@item.Phone</td>
                        <td>@item.Email</td>

                        @if (User.IsInRole("Admin"))
                        {
                            <td>
                                <div class="app-row-actions">
                                    <a asp-action="Details" asp-route-id="@item.ClubId" class="app-details-link">Details</a>
                                    <a asp-action="Edit" asp-route-id="@item.ClubId" class="app-edit-link">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.ClubId" class="app-delete-link">Delete</a>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

</section>
@model JyoshinmonKarate.Models.Club

@{
    ViewData["Title"] = "Dojo Details";
}

<section class="app-form-page">
    <div class="app-form-card">

        <div class="app-form-header">
            <h1>Dojo Details</h1>
        </div>

        <div class="details-grid">
            <div class="details-item">
                <span>Dojo Name</span>
                <p>@Model.ClubName</p>
            </div>

            <div class="details-item">
                <span>Phone</span>
                <p>@Model.Phone</p>
            </div>

            <div class="details-item full-width">
                <span>Address</span>
                <p>@Model.Address</p>
            </div>

            <div class="details-item full-width">
                <span>Email</span>
                <p>@Model.Email</p>
            </div>
        </div>

        <div class="form-actions">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.ClubId" class="app-primary-btn">Edit Dojo</a>
            }

            <a asp-action="Index" class="app-cancel-link">Back to List</a>
        </div>

    </div>
</section>
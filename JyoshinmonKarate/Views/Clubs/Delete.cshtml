@model JyoshinmonKarate.Models.Club

@{
    ViewData["Title"] = "Delete Dojo";
}

<section class="app-form-page">
    <div class="app-form-card">

        <div class="app-form-header">
            <h1>Delete Dojo</h1>
            <p class="warning">Are you sure you want to delete this dojo?</p>
        </div>

        <div class="details-grid">
            <div class="details-item">
                <span>Dojo Name</span>
                <p>@Model.ClubName</p>
            </div>

            <div class="details-item">
                <span>Phone</span>
                <p>@Model.Phone</p>
            </div>

            <div class="details-item full-width">
                <span>Address</span>
                <p>@Model.Address</p>
            </div>

            <div class="details-item full-width">
                <span>Email</span>
                <p>@Model.Email</p>
            </div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="ClubId" />

            <div class="form-actions">
                <button type="submit" class="app-danger-btn">Delete Dojo</button>
                <a asp-action="Index" class="app-cancel-link">Cancel</a>
            </div>
        </form>

    </div>
</section>
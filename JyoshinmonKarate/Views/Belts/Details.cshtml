@model JyoshinmonKarate.Models.Belt

@{
    ViewData["Title"] = "Belt Details";
}

<section class="app-form-page">
    <div class="app-form-card">

        <div class="app-form-header">
            <h1>Belt Details</h1>
        </div>

        <div class="details-grid">
            <div class="details-item">
                <span>Belt Name</span>
                <p>@Model.BeltName</p>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Edit" asp-route-id="@Model.BeltId" class="app-primary-btn">Edit Belt</a>
            <a asp-action="Index" class="app-cancel-link">Back to List</a>
        </div>

    </div>
</section>
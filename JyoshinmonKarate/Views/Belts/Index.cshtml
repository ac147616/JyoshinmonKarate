@model IEnumerable<JyoshinmonKarate.Models.Belt>

@{
    ViewData["Title"] = "Belts";
}

<section class="app-index-page compact">

    <div class="belt-content">

        <div class="app-header-row">
            <div class="app-page-header">
                <h1>Belts</h1>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="app-add-btn">
                    <i class="bi bi-plus-lg"></i>
                    Add Belt
                </a>
            }
        </div>

        <div class="app-table-wrap">
            <table class="app-table belt-table">
                <thead>
                    <tr>
                        <th>Belt Name</th>

                        @if (User.IsInRole("Admin"))
                        {
                            <th>Actions</th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="app-primary-cell">
                                @item.BeltName
                            </td>

                            @if (User.IsInRole("Admin"))
                            {
                                <td>
                                    <div class="app-row-actions">
                                        <a asp-action="Details" asp-route-id="@item.BeltId" class="app-details-link">Details</a>
                                        <a asp-action="Edit" asp-route-id="@item.BeltId" class="app-edit-link">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@item.BeltId" class="app-delete-link">Delete</a>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</section>
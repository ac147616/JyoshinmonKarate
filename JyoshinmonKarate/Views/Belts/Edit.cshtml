@model JyoshinmonKarate.Models.Belt

@{
    ViewData["Title"] = "Edit Belt";
}

<section class="app-form-page">
    <div class="app-form-card">

        <div class="app-form-header">
            <h1>Edit Belt</h1>
        </div>

        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="BeltId" />

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="BeltName"></label>
                    <input asp-for="BeltName" class="form-control" />
                    <span asp-validation-for="BeltName" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="app-primary-btn">Save Changes</button>
                <a asp-action="Index" class="app-cancel-link">Cancel</a>
            </div>
        </form>

    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
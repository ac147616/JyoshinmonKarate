@model JyoshinmonKarate.Models.Belt

@{
    ViewData["Title"] = "Delete Belt";
}

<section class="app-form-page">
    <div class="app-form-card">

        <div class="app-form-header">
            <h1>Delete Belt</h1>
            <p class="warning">Are you sure you want to delete this belt?</p>
        </div>

        <div class="details-grid">
            <div class="details-item">
                <span>Belt Name</span>
                <p>@Model.BeltName</p>
            </div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="BeltId" />

            <div class="form-actions">
                <button type="submit" class="app-danger-btn">Delete Belt</button>
                <a asp-action="Index" class="app-cancel-link">Cancel</a>
            </div>
        </form>

    </div>
</section>
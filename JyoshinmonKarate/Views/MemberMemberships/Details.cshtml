@model JyoshinmonKarate.Models.MemberMembership

@{
    ViewData["Title"] = "Member Membership Details";

    string memberName = Model.Member.FirstName + " " + Model.Member.LastName;
    string statusClass = "status-muted";

    if (Model.MembershipStatus == JyoshinmonKarate.Models.MembershipStatus.Active)
    {
        statusClass = "status-success";
    }
    else if (Model.MembershipStatus == JyoshinmonKarate.Models.MembershipStatus.Suspended)
    {
        statusClass = "status-warning";
    }
    else if (Model.MembershipStatus == JyoshinmonKarate.Models.MembershipStatus.Cancelled)
    {
        statusClass = "status-danger";
    }
}

<section class="app-form-page">
    <div class="app-form-card">

        <div class="app-form-header">
            <h1>Membership Details</h1>
        </div>

        <div class="details-grid">

            <div class="details-item">
                <span>Member</span>
                <p>@memberName</p>
            </div>

            <div class="details-item">
                <span>Membership</span>
                <p>@Model.Membership.MembershipName</p>
            </div>

            <div class="details-item">
                <span>Start Date</span>
                <p>@Model.StartDate.ToString("dd MMM yyyy")</p>
            </div>

            <div class="details-item">
                <span>End Date</span>
                <p>@Model.EndDate.ToString("dd MMM yyyy")</p>
            </div>

            <div class="details-item">
                <span>Membership Status</span>
                <p class="status @statusClass">@Model.MembershipStatus</p>
            </div>

        </div>

        <div class="form-actions">
            <a asp-action="Edit" asp-route-id="@Model.MemberMembershipId" class="app-primary-btn">Edit Membership</a>
            <a asp-action="Index" class="app-cancel-link">Back to List</a>
        </div>

    </div>
</section>
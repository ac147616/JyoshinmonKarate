@model JyoshinmonKarate.Models.Membership

@{
    ViewData["Title"] = "Delete Membership Plan";
}

<section class="app-form-page">
    <div class="app-form-card">

        <div class="app-form-header">
            <h1>Delete Membership Plan</h1>
            <p class="warning">Deleting this plan will permanently remove it from the system.</p>
        </div>

        <div class="details-grid">

            <div class="details-item">
                <span>Membership Name</span>
                <p>@Model.MembershipName</p>
            </div>

            <div class="details-item">
                <span>Membership Cost</span>
                <p>$@Model.Cost.ToString("0.00")</p>
            </div>

            <div class="details-item">
                <span>Age Group</span>
                <p>@Model.AgeGroup</p>
            </div>

        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="MembershipId" />

            <div class="form-actions">
                <button type="submit" class="app-danger-btn">Delete Plan</button>
                <a asp-action="Index" class="app-cancel-link">Cancel</a>
            </div>
        </form>

    </div>
</section>
@model IEnumerable<JyoshinmonKarate.Models.Membership>

@{
    ViewData["Title"] = "Membership Plans";
    bool isAdmin = User.IsInRole("Admin");
}

<section class="app-index-page compact membership-index-page">

    <div class="app-header-row">
        <div class="app-page-header">
            <h1>Membership Plans</h1>
        </div>

        @if (isAdmin)
        {
            <a asp-action="Create" class="app-add-btn">
                <i class="bi bi-plus-lg"></i>
                Add Membership Plan
            </a>
        }
    </div>

    <div class="app-table-wrap">
        <table class="app-table membership-table">
            <thead>
                <tr>
                    <th>Membership Name</th>
                    <th>Cost</th>
                    <th>Age Group</th>

                    @if (isAdmin)
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="app-primary-cell">@item.MembershipName</td>
                        <td>$@item.Cost.ToString("0.00")</td>
                        <td>@item.AgeGroup</td>

                        @if (isAdmin)
                        {
                            <td>
                                <div class="app-row-actions">
                                    <a asp-action="Details" asp-route-id="@item.MembershipId" class="app-details-link">Details</a>
                                    <a asp-action="Edit" asp-route-id="@item.MembershipId" class="app-edit-link">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.MembershipId" class="app-delete-link">Delete</a>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

</section>
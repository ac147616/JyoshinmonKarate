@model JyoshinmonKarate.Models.Membership

@{
    ViewData["Title"] = "Membership Plan Details";
}

<section class="app-form-page">
    <div class="app-form-card">

        <div class="app-form-header">
            <h1>Membership Plan Info</h1>
        </div>

        <div class="details-grid">

            <div class="details-item">
                <span>Membership Name</span>
                <p>@Model.MembershipName</p>
            </div>

            <div class="details-item">
                <span>Membership Cost</span>
                <p>$@Model.Cost.ToString("0.00")</p>
            </div>

            <div class="details-item">
                <span>Age Group</span>
                <p>@Model.AgeGroup</p>
            </div>

        </div>

        <div class="form-actions">
            <a asp-action="Edit" asp-route-id="@Model.MembershipId" class="app-primary-btn">Edit Plan</a>
            <a asp-action="Index" class="app-cancel-link">Back to List</a>
        </div>

    </div>
</section>